# Paste into Streamlit Community Cloud's managed secrets editor.
# Replace every placeholder. Never save the resulting real file in Git.

APP_ENV = "pilot"
APP_PUBLIC_URL = "https://YOUR-APP.streamlit.app"
AUTH_MODE = "google"
ACCESS_POLICY = "google_any"
ADMIN_EMAILS = "admin1@example.org,admin2@example.org"
CONSENT_VERSION = "pilot-2026-08"

# Prefer the Supabase connection-pooler URI recommended for hosted clients.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:PORT/postgres"
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "YOUR-SERVICE-ROLE-KEY"
SUPABASE_STORAGE_BUCKET = "pilot-files"
RETENTION_DAYS = 30

OPENROUTER_API_KEY = "PILOT-ONLY-KEY"
OPENROUTER_FAST_MODEL = "google/gemini-2.5-flash-lite"
OPENROUTER_DEEP_MODEL = "openai/gpt-5.4-mini"
ENABLE_TRUSTED_WEB_SEARCH = true
TRUSTED_SEARCH_MAX_RESULTS = 5
TRUSTED_SEARCH_MAX_CALLS = 2

MAX_QUERIES_PER_USER_DAY = 30
MAX_PILOT_QUERIES_PER_DAY = 500
MAX_DEEP_QUERIES_PER_USER_DAY = 10
MAX_ARTIFACTS_PER_USER_DAY = 10
PILOT_COOLDOWN_SECONDS = 2

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "GENERATE-A-LONG-RANDOM-SECRET"
client_id = "GOOGLE-OAUTH-CLIENT-ID"
client_secret = "GOOGLE-OAUTH-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"


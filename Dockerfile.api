FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system raise && useradd --system --gid raise --create-home raise

WORKDIR /app
COPY requirements.txt requirements.lock.txt ./
RUN python -m pip install --upgrade pip && python -m pip install -r requirements.lock.txt

COPY alembic.ini ./
COPY migrations ./migrations
COPY farmers_chatbot ./farmers_chatbot
COPY knowledge_base ./knowledge_base
COPY config ./config
COPY legal ./legal
COPY scripts ./scripts
COPY rag_chatbot.py mcp_server.py whatsapp_api.py ./

RUN mkdir -p /app/data /app/model-cache /app/reports/generated \
    && chown -R raise:raise /app

USER raise
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)" || exit 1

CMD ["sh", "-c", "python -m alembic upgrade head && exec python -m uvicorn farmers_chatbot.web_api:app --host 0.0.0.0 --port 8000"]

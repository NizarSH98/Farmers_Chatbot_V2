{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raise.eval.report.v1",
  "title": "RAISE deterministic evaluation report v1",
  "type": "object",
  "required": [
    "schema_version", "harness_version", "system_id", "top_k", "coverage", "metrics", "cases", "dataset"
  ],
  "properties": {
    "schema_version": {"const": "raise.eval.report.v1"},
    "harness_version": {"type": "string"},
    "system_id": {"type": "string"},
    "top_k": {"type": "integer", "minimum": 1},
    "coverage": {"type": "object"},
    "metrics": {
      "type": "object",
      "required": ["retrieval", "graph", "citations", "safety", "quality", "efficiency"]
    },
    "cases": {"type": "array"},
    "dataset": {
      "type": "object",
      "required": ["id", "version", "split", "cases_sha256", "runs_sha256"]
    },
    "pairwise": {"type": "array"},
    "ablation_manifest": {"type": "object"}
  }
}

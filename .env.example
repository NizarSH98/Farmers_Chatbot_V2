# Required only for connected model generation.
OPENROUTER_API_KEY=

# Deployment identity and provider attribution.
APP_PUBLIC_URL=
APP_DISPLAY_NAME=RAISE
APP_ENV=development
AUTH_MODE=disabled
ACCESS_POLICY=google_any
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
ADMIN_EMAILS=
CONSENT_VERSION=project-2026-08-v1
ORGANIZATION_NAME=RAISE-ESDU
PRIVACY_CONTACT_EMAIL=

# Persistence. PostgreSQL is required; there is no local database fallback.
DATABASE_URL=
# Durable checkpointing for the resumable clarification workflow. Leave
# blank to fall back to non-durable in-memory checkpoints. Compose sets
# this explicitly; never commit a real credential here.
CLARIFICATION_DATABASE_URL=
LOCAL_FILE_ROOT=data/pilot_files
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pilot-files
RETENTION_DAYS=30

# The server allowlist controls what testers can choose. GPT-5.6 Luna is the
# default: strong reasoning at roughly a fifteenth of Kimi K3's input cost, with
# image input and native structured outputs for the request analyzer. Kimi K3
# stays available for the hardest questions.
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.6-luna
OPENROUTER_ALLOWED_MODELS=openai/gpt-5.6-luna,moonshotai/kimi-k3,xiaomi/mimo-v2.5,minimax/minimax-m3
OPENROUTER_FAST_MODEL=openai/gpt-5.6-luna
OPENROUTER_DEEP_MODEL=openai/gpt-5.6-luna
REQUEST_ANALYZER_MODEL=openai/gpt-5.6-luna
ANSWER_VERIFIER_MODEL=openai/gpt-5.6-luna
OPENROUTER_ENFORCE_ZDR=true
OPENROUTER_DATA_COLLECTION=deny

# Pilot cost and abuse controls. Provider-side key limits are still required.
MAX_QUERIES_PER_SESSION=25
MAX_QUERIES_PER_DAY_GLOBAL=300
COOLDOWN_SECONDS=3
MAX_QUERIES_PER_USER_DAY=30
MAX_PILOT_QUERIES_PER_DAY=500
MAX_DEEP_QUERIES_PER_USER_DAY=10
MAX_ARTIFACTS_PER_USER_DAY=10
MAX_USER_WEEKLY_COST_USD=7.0
PILOT_COOLDOWN_SECONDS=2

# Direct, operator-authorized live-source connectors (fail closed).
ENABLE_TRUSTED_WEB_SEARCH=false
LIVE_SOURCE_REGISTRY_PATH=config/live_sources.v1.json
TRUSTED_SEARCH_MAX_RESULTS=5
# Qdrant is a rebuildable retrieval projection; PostgreSQL remains authoritative.
RAG_BACKEND=qdrant
QDRANT_URL=http://localhost:6433
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
RAG_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_LOCAL_EMBEDDING_DIMENSIONS=384
RAG_LOCAL_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
RAG_ENABLE_RERANKER=false
RAG_ENABLE_QUANTIZATION=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GRAPH_MODEL=qwen3:4b-q4_K_M
RAG_GRAPH_BUILD_MAX_RETRIES=2
TRUSTED_SEARCH_MAX_CALLS=2

# Hybrid GraphRAG. Keep vector retrieval disabled until the hidden bilingual
# benchmark selects one model/dimension pair. Lexical + graph remain available.
RAG_VECTOR_BENCHMARK_APPROVED=false
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_BENCHMARK_REPORT=
RAG_EMBEDDING_BENCHMARK_SHA256=

# Render/Meta test-number channel. Never commit real values.
# This compatibility adapter stays disabled until the canonical web soak passes.
WHATSAPP_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v23.0
WHATSAPP_ID_SECRET=
WHATSAPP_MAX_REPLY_CHARS=3500

# Documented local defaults and production variable names; never store secrets here.
# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
APP_DISPLAY_NAME=RAISE
ORGANIZATION_NAME=RAISE-ESDU
PRIVACY_CONTACT_EMAIL=privacy-contact-not-configured@example.invalid
CONSENT_VERSION=project-2026-09-v2
RETENTION_DAYS=30
FORWARDED_ALLOW_IPS=127.0.0.1
GRACEFUL_SHUTDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# Local Compose uses disabled auth. Pilot/production must use oidc.
WEB_AUTH_MODE=disabled
APP_SESSION_SECRET=local-development-session-secret
AUTH_SESSION_MAX_AGE_SECONDS=28800
ACCESS_POLICY=any_verified_email
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
ADMIN_EMAILS=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Public callback through the Next.js proxy, for example:
# https://raise.example.org/api/auth/callback
OIDC_REDIRECT_URI=
AUTH_POST_LOGIN_REDIRECT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Compose constructs DATABASE_URL internally from POSTGRES_PASSWORD. External
# runs may set DATABASE_URL directly. Replace this local-only password in every
# pilot/production deployment.
POSTGRES_PASSWORD=raise-local-only
DATABASE_URL=
CLARIFICATION_DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# ---------------------------------------------------------------------------
# PRIVATE FILE STORAGE
# ---------------------------------------------------------------------------
# local = encrypted/off-VPS backup of the persistent Docker volume is required.
# s3 = AWS S3 or an S3-compatible private bucket.
STORAGE_BACKEND=local
LOCAL_FILE_ROOT=data/pilot_files
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# EXTERNAL BACKUPS (production profile)
# ---------------------------------------------------------------------------
# Example: s3:https://s3.example.org/raise-backups/production
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_HOST=raise-vps

# ---------------------------------------------------------------------------
# RAG / VECTOR SERVICES
# ---------------------------------------------------------------------------
RAG_BACKEND=qdrant
QDRANT_URL=http://localhost:6433
# Required, random 32+ characters in pilot/production.
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
RAG_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_LOCAL_EMBEDDING_DIMENSIONS=384
RAG_LOCAL_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
RAG_ENABLE_RERANKER=false
RAG_ENABLE_QUANTIZATION=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GRAPH_MODEL=qwen3:4b-q4_K_M
RAG_GRAPH_BUILD_MAX_RETRIES=2
RAG_VECTOR_BENCHMARK_APPROVED=false
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_BENCHMARK_REPORT=
RAG_EMBEDDING_BENCHMARK_SHA256=

# ---------------------------------------------------------------------------
# AI / EXTERNAL APIS
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.6-luna
OPENROUTER_ALLOWED_MODELS=openai/gpt-5.6-luna,moonshotai/kimi-k3,xiaomi/mimo-v2.5,minimax/minimax-m3
OPENROUTER_FAST_MODEL=openai/gpt-5.6-luna
OPENROUTER_DEEP_MODEL=openai/gpt-5.6-luna
REQUEST_ANALYZER_MODEL=openai/gpt-5.6-luna
ANSWER_VERIFIER_MODEL=openai/gpt-5.6-luna
OPENROUTER_ENFORCE_ZDR=true
OPENROUTER_DATA_COLLECTION=deny
ENABLE_TRUSTED_WEB_SEARCH=false
LIVE_SOURCE_REGISTRY_PATH=config/live_sources.v1.json
TRUSTED_SEARCH_MAX_RESULTS=5
TRUSTED_SEARCH_MAX_CALLS=2

# ---------------------------------------------------------------------------
# COST, RATE, AND UPLOAD LIMITS
# ---------------------------------------------------------------------------
MAX_QUERIES_PER_SESSION=25
MAX_QUERIES_PER_DAY_GLOBAL=300
COOLDOWN_SECONDS=3
MAX_QUERIES_PER_USER_DAY=30
MAX_PILOT_QUERIES_PER_DAY=500
MAX_DEEP_QUERIES_PER_USER_DAY=10
MAX_ARTIFACTS_PER_USER_DAY=10
MAX_USER_WEEKLY_COST_USD=7.0
PILOT_COOLDOWN_SECONDS=2
MAX_PROJECT_FILES=5
MAX_PROJECT_FILE_BYTES=10485760
MAX_CHAT_IMAGE_BYTES=5242880

# ---------------------------------------------------------------------------
# OPTIONAL WHATSAPP COMPATIBILITY ADAPTER
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v23.0
WHATSAPP_ID_SECRET=
WHATSAPP_MAX_REPLY_CHARS=3500

# ---------------------------------------------------------------------------
# IMAGE / LOCAL COMPOSE CONTROLS
# ---------------------------------------------------------------------------
API_IMAGE=raise-api:local
WEB_IMAGE=raise-web:local
BACKUP_IMAGE=raise-backup:local
# Build-time switch. Must be false in every authenticated deployment.
NEXT_PUBLIC_LOCAL_AUTH=false

# Required only for connected model generation.
OPENROUTER_API_KEY=

# Deployment identity and provider attribution.
APP_PUBLIC_URL=
APP_DISPLAY_NAME=RAISE-ESDU Farmer Assistant
APP_ENV=development
AUTH_MODE=disabled
ACCESS_POLICY=google_any
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
ADMIN_EMAILS=
CONSENT_VERSION=project-2026-08-v1
ORGANIZATION_NAME=RAISE-ESDU
PRIVACY_CONTACT_EMAIL=

# Persistence. Use SQLite/local files only for development.
DATABASE_URL=
LOCAL_PILOT_DB_PATH=data/pilot.sqlite3
LOCAL_FILE_ROOT=data/pilot_files
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pilot-files
RETENTION_DAYS=30

# Models verified for reasoning and tool use as of 2026-07-29.
OPENROUTER_FAST_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_DEEP_MODEL=openai/gpt-5.4-mini

# Pilot cost and abuse controls. Provider-side key limits are still required.
MAX_QUERIES_PER_SESSION=25
MAX_QUERIES_PER_DAY_GLOBAL=300
COOLDOWN_SECONDS=3
RUNTIME_DB_PATH=data/runtime.sqlite3
MAX_QUERIES_PER_USER_DAY=30
MAX_PILOT_QUERIES_PER_DAY=500
MAX_DEEP_QUERIES_PER_USER_DAY=10
MAX_ARTIFACTS_PER_USER_DAY=10
PILOT_COOLDOWN_SECONDS=2

# Trusted domain-filtered search through OpenRouter (beta; fail-closed fallback).
ENABLE_TRUSTED_WEB_SEARCH=false
TRUSTED_SEARCH_MAX_RESULTS=5
TRUSTED_SEARCH_MAX_CALLS=2

# Render/Meta test-number channel. Never commit real values.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v23.0
WHATSAPP_ID_SECRET=
WHATSAPP_MAX_REPLY_CHARS=3500

# Optional local speech-to-text model: tiny, base, small, medium, or large.
WHISPER_MODEL=base

temp_dir/
*.tmp
*.wav
*.mp3

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Models (too large for git)
*.pt
*.bin
*.onnx

# Local runtime evidence and databases
data/*.sqlite3
data/*.sqlite3-*
data/pilot_files/
data/artifacts/
reports/generated/
pilot_exports/

# Hidden evaluation cases are supplied out-of-band and must never be committed.
evaluation/hidden/
# Local release-candidate backups and vector snapshots are portable evidence,
# but can contain private pilot data and are never source-controlled.
backups/
snapshots/
*.dump
*.sql.gz
*.snapshot

# Rebuildable local model/build artifacts and signed reports.
model-cache/
build-cache/
build-reports/


# Raw source intake is reviewed locally before approved claims are promoted.
knowledge_base/incoming/
# The contractual DOCX is local source evidence. Generated, reviewed Markdown
# releases are tracked; the original binary is retained outside Git.
knowledge_base/ESDU_Agrifood_Knowledge_Base_v0.1.docx


# Contractual source workbook is local evidence, not deployed runtime material.
RAISE_Logframe_final.xlsx

# Node / Next.js
node_modules/
.next/
tsconfig.tsbuildinfo

# Test/build output
.pytest_cache/
.coverage
htmlcov/
